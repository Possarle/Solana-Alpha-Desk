# All prices, capital and simulated P&L are USD. The initial paper balance is $10,000.
DATABASE_URL=sqlite:///./alpha.db
RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=
# Required for a shared/private Codespace URL; never put this in a VITE_ variable.
DASHBOARD_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SCAN_INTERVAL=90
RISK_INTERVAL=15
WALLET_INTERVAL=120
ENABLE_SCHEDULER=true
# Launch mode: PumpPortal real-time feed of new pump.fun tokens, separate shadow account.
LAUNCH_MODE=true
# Supervised live is isolated. Read docs/LIVE.md before configuring.
LIVE_ENABLED=false
LIVE_WALLET_ADDRESS=
LIVE_KEYPAIR_PATH=
LIVE_ACKNOWLEDGEMENT=
LIVE_MAX_ORDER_USDC=10
LIVE_MAX_SLIPPAGE_BPS=100
LIVE_MAX_PRICE_IMPACT_PCT=1
LIVE_MAX_FEE_LAMPORTS=50000
LIVE_DAILY_FEE_LAMPORTS=500000
LIVE_COMPUTE_PRICE_MICRO_LAMPORTS=1000
LIVE_REVIEW_SECONDS=45
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Optional: alerts are sent only after both values are explicitly configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
