# All prices, capital and simulated P&L are USD. The initial paper balance is $10,000.
DATABASE_URL=sqlite:///./alpha.db
RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=
# Required for a shared/private Codespace URL; never put this in a VITE_ variable.
DASHBOARD_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SCAN_INTERVAL=90
RISK_INTERVAL=15
WALLET_INTERVAL=120
ENABLE_SCHEDULER=true
# Intentionally ineffective for broadcasts: no signer or send path is included.
LIVE_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Optional: alerts are sent only after both values are explicitly configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
